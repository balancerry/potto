# Supabase project URL. Dashboard > Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (publishable) key. Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment, used to build auth redirect URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Optional: lets the installed mobile app open /pot/<token> share links (iOS Universal Links / Android App Links).
# Leave unset until the app has a bundle id / package and signing fingerprints; the verification URLs 404 until then.
APPLE_APP_ID=
ANDROID_PACKAGE=
ANDROID_SHA256_CERT_FINGERPRINTS=
