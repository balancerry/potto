# Supabase project URL. Dashboard > Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (publishable) key. Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment, used to build auth redirect URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=
